@page "/"
@rendermode InteractiveServer
@using RestaurantSimulation.Domain.Aggregates
@using RestaurantSimulation.Domain.Common
@using RestaurantSimulation.Domain.Entities
@using RestaurantSimulation.Domain.Time

<h3>Restaurant</h3>
<p>Max siting capacity = @_restaurants.MaxSeatingCapacity</p>
<input type="number" min="1" @bind="_selectedCapacity"/>
<button @onclick="AddTable">Add table</button>

<input type="number" min="1" @bind="_groupSize" />
<button @onclick="AddCustomerGroup">Add Customer group</button>

<div>
    <p>Waiting</p>
    <div style="display: flex; justify-content: left; align-items: center; flex-wrap: wrap; margin-top: 10px; gap:5px;">
        @foreach (var waitingGroup in _restaurants.WaitingGuests)
        {
            <div class="circle">
                @waitingGroup.Size
            </div>
        }
       
    </div>
</div>
<div style="display:flex; gap: 80px; margin-top: 100px; margin-left: 100px;">
    @for (int i=0; i<_restaurants.Tables.Count; i++)
    {
        var table = _restaurants.Tables.ElementAt(i);
        <div class="table @(table.IsOccupied ? "occupied" : "free")">
            @(i + 1)
            @(table.SeatedGroup?.Size.ToString() ?? "")
        </div>
        
    }
</div>

@code {
    private static readonly ITimeProvider Clock = new SystemTimeProvider();
    private readonly Restaurant _restaurants = Restaurant.Create(20, Clock );
    
    private int _selectedCapacity = 4;
    private int _groupSize = 4;

    private void AddTable()
    {
        _restaurants.AddTable(_selectedCapacity);
    }

    private void AddCustomerGroup()
    {
        var result = CustomerGroup.Create(_groupSize);
        if (!result.IsSuccess)
        {
            return;
        }

        _restaurants.TrySeat(result.Value!);
    }
}