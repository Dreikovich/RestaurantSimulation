@page "/"
@rendermode InteractiveServer
@using RestaurantSimulation.Domain.Aggregates
@using RestaurantSimulation.Domain.Common
@using RestaurantSimulation.Domain.Time

<h3>Restaurant</h3>
<p>Max siting capacity = @_restaurants.MaxSeatingCapacity</p>
<input type="number" min="1" @bind="_selectedCapacity"/>
<button @onclick="AddTable">Add table</button>

<div style="display:flex; gap: 80px; margin-top: 100px; margin-left: 100px;">
    @for (int i=0; i<_restaurants.Tables.Count; i++)
    {
        <div class="table @(_restaurants.Tables.ElementAt(i).IsOccupied ? "occupied" : "free")">
            @(i + 1)
        </div>
    }
</div>

@code {
    private static readonly ITimeProvider Clock = new SystemTimeProvider();
    private readonly Restaurant _restaurants = Restaurant.Create(20, Clock );
    
    private int _selectedCapacity = 4;

    private void AddTable()
    {
        var result = _restaurants.AddTable(_selectedCapacity);
        Console.WriteLine(result);
    }
    
}